<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-policy</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-policy-bootstrap</artifactId>
    <name>titanium-policy-bootstrap</name>
    <description>保单系统 - 启动模块</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web层 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-policy-web</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 基础设施层：bootstrap 作为组合根(composition root)在运行时提供 Adapter/仓储实现/JPA实体，
             供 @ComponentScan/@EntityScan/@EnableJpaRepositories 装配。application 等内层不再依赖 infra，
             依赖倒置由组合根在此收口（标准 DDD 洋葱/六边形：内层依赖抽象，实现由最外层组合根注入）。 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-policy-infrastructure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        
        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        
        <!-- Spring Boot DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        
        <!-- Axon Framework -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-spring-boot-starter</artifactId>
        </dependency>
        <!-- Liquibase核心依赖 -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <!-- Spring Boot整合Liquibase（可选，简化配置） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        
        <!-- Common Project -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-common</artifactId>
        </dependency>

        <!-- ============ 架构守护测试（仅 test 作用域，不进运行时） ============ -->
        <!-- 共享 ArchUnit 基类制品：提供 AbstractArchitectureGuardTest -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-build-tools</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit：以 JUnit 测试形式校验 CLAUDE.md 的分层/命名/依赖约束（版本由 parent 管理） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot Test：提供 JUnit5 运行环境 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.titanium.policy.bootstrap.PolicyApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>