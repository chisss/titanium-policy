<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- 批单读模型表 + 保单读模型当前版本号列：由 PolicyEndorsedEvent 投影维护（保单批改流水） -->
    <changeSet id="20260628-policy-endorsement-projection" author="titanium-cqrs">
        <createTable tableName="t_policy_endorsement_view" remarks="批单读模型表（保单批改流水）">
            <column name="endorsement_no" type="VARCHAR(64)" remarks="批单号（读模型主键）">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_t_policy_endorsement_view"/>
            </column>
            <column name="policy_id" type="VARCHAR(36)" remarks="保单ID">
                <constraints nullable="false"/>
            </column>
            <column name="update_type" type="VARCHAR(40)" remarks="批改类型编码">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(20)" remarks="批改大类编码">
                <constraints nullable="false"/>
            </column>
            <column name="policy_version" type="INT" remarks="批改后保单版本号">
                <constraints nullable="false"/>
            </column>
            <column name="effective_date" type="DATETIME" remarks="批单生效日"/>
            <column name="change_summary" type="VARCHAR(512)" remarks="变更摘要"/>
            <column name="requires_premium_recalc" type="TINYINT" defaultValueNumeric="0" remarks="是否触发保费重算">
                <constraints nullable="false"/>
            </column>
            <column name="source_maintenance_id" type="VARCHAR(36)" remarks="来源保全案件ID"/>
            <column name="operator_id" type="VARCHAR(50)" remarks="操作人"/>
            <column name="tenant_id" type="VARCHAR(36)" remarks="租户ID（多租户隔离）">
                <constraints nullable="false"/>
            </column>
            <column name="endorsed_at" type="DATETIME" remarks="批改落地时间">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="t_policy_endorsement_view" indexName="idx_endorsement_policy">
            <column name="policy_id"/>
            <column name="tenant_id"/>
        </createIndex>

        <!-- 保单读模型新增当前业务版本号列（批改后递增） -->
        <addColumn tableName="t_policy_view">
            <column name="current_version" type="INT" remarks="保单当前业务版本号（批改后递增）"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
