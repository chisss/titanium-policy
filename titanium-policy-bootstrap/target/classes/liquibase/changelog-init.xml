<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- 初始化数据库表结构 -->
    <changeSet id="1" author="titanium">
        <!-- 创建保单主表 -->
        <createTable tableName="t_policy">
            <column name="id" type="VARCHAR(32)" constraints="primaryKey notNull" comment="保单ID（雪花算法）"/>
            <column name="tenant_id" type="VARCHAR(32)" constraints="notNull" comment="租户ID"/>
            <column name="proposal_id" type="VARCHAR(32)" constraints="notNull" comment="投保单ID"/>
            <column name="policy_type" type="VARCHAR(32)" constraints="notNull" comment="保单类型（INDIVIDUAL/GROUP/FAMILY）"/>
            <column name="insurance_type" type="VARCHAR(32)" constraints="notNull" comment="险种类型"/>
            <column name="clause_id" type="VARCHAR(32)" constraints="notNull" comment="条款ID"/>
            <column name="policy_holder_id" type="VARCHAR(32)" constraints="notNull" comment="投保人ID"/>
            <column name="insured_id" type="VARCHAR(32)" constraints="notNull" comment="被保人ID"/>
            <column name="sum_insured" type="DECIMAL(18,2)" constraints="notNull" comment="基础保额"/>
            <column name="add_sum_insured" type="DECIMAL(18,2)" constraints="notNull" comment="附加保额"/>
            <column name="premium" type="DECIMAL(18,2)" constraints="notNull" comment="保费"/>
            <column name="policy_status" type="VARCHAR(32)" constraints="notNull" comment="状态（UNDERWRITING/VALID/TERMINATED/EXPIRED）"/>
            <column name="start_date" type="DATETIME" constraints="notNull" comment="保险起期"/>
            <column name="end_date" type="DATETIME" constraints="notNull" comment="保险止期"/>
            <column name="create_time" type="DATETIME" constraints="notNull" defaultValueComputed="CURRENT_TIMESTAMP" comment="创建时间"/>
            <column name="update_time" type="DATETIME" constraints="notNull" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" comment="更新时间"/>
            <column name="created_by" type="VARCHAR(32)" constraints="notNull" comment="创建人"/>
            <column name="updated_by" type="VARCHAR(32)" constraints="notNull" comment="更新人"/>
            <column name="is_deleted" type="TINYINT" constraints="notNull" defaultValue="0" comment="是否删除（0: 未删除, 1: 已删除）"/>
        </createTable>

        <!-- 创建索引 -->
        <createIndex tableName="t_policy" indexName="idx_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="t_policy" indexName="idx_proposal_id">
            <column name="proposal_id"/>
        </createIndex>
        <createIndex tableName="t_policy" indexName="idx_policy_type">
            <column name="policy_type"/>
        </createIndex>
        <createIndex tableName="t_policy" indexName="idx_insurance_type">
            <column name="insurance_type"/>
        </createIndex>
        <createIndex tableName="t_policy" indexName="idx_clause_id">
            <column name="clause_id"/>
        </createIndex>
        <createIndex tableName="t_policy" indexName="idx_policy_holder_id">
            <column name="policy_holder_id"/>
        </createIndex>
        <createIndex tableName="t_policy" indexName="idx_insured_id">
            <column name="insured_id"/>
        </createIndex>
        <createIndex tableName="t_policy" indexName="idx_policy_status">
            <column name="policy_status"/>
        </createIndex>
        <createIndex tableName="t_policy" indexName="idx_start_end_date">
            <column name="start_date"/>
            <column name="end_date"/>
        </createIndex>
    </changeSet>
    
    <!-- 创建投保单表 -->
    <changeSet id="2" author="titanium">
        <createTable tableName="t_policy_proposal">
            <column name="id" type="VARCHAR(32)" constraints="primaryKey notNull" comment="投保单ID（雪花算法）"/>
            <column name="tenant_id" type="VARCHAR(32)" constraints="notNull" comment="租户ID"/>
            <column name="policy_holder_id" type="VARCHAR(32)" constraints="notNull" comment="投保人ID（关联客户表）"/>
            <column name="insured_id" type="VARCHAR(32)" constraints="notNull" comment="被保人ID（关联客户表）"/>
            <column name="insurance_type" type="VARCHAR(32)" constraints="notNull" comment="险种类型（AUTO/LIFE/PET）"/>
            <column name="clause_id" type="VARCHAR(32)" constraints="notNull" comment="条款ID（关联条款表）"/>
            <column name="sum_insured" type="DECIMAL(18,2)" constraints="notNull" comment="保额"/>
            <column name="proposal_status" type="VARCHAR(32)" constraints="notNull" comment="状态（SUBMITTED/REJECTED/APPROVED）"/>
            <column name="submit_time" type="DATETIME" comment="提交时间"/>
            <column name="reject_reason" type="VARCHAR(512)" comment="拒保原因"/>
            <column name="create_time" type="DATETIME" constraints="notNull" defaultValueComputed="CURRENT_TIMESTAMP" comment="创建时间"/>
            <column name="update_time" type="DATETIME" constraints="notNull" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" comment="更新时间"/>
            <column name="created_by" type="VARCHAR(32)" constraints="notNull" comment="创建人"/>
            <column name="updated_by" type="VARCHAR(32)" constraints="notNull" comment="更新人"/>
            <column name="is_deleted" type="TINYINT" constraints="notNull" defaultValue="0" comment="是否删除（0: 未删除, 1: 已删除）"/>
        </createTable>
        
        <!-- 创建索引 -->
        <createIndex tableName="t_policy_proposal" indexName="idx_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="t_policy_proposal" indexName="idx_policy_holder_id">
            <column name="policy_holder_id"/>
        </createIndex>
        <createIndex tableName="t_policy_proposal" indexName="idx_insured_id">
            <column name="insured_id"/>
        </createIndex>
        <createIndex tableName="t_policy_proposal" indexName="idx_insurance_type">
            <column name="insurance_type"/>
        </createIndex>
        <createIndex tableName="t_policy_proposal" indexName="idx_clause_id">
            <column name="clause_id"/>
        </createIndex>
        <createIndex tableName="t_policy_proposal" indexName="idx_proposal_status">
            <column name="proposal_status"/>
        </createIndex>
    </changeSet>
    
    <!-- 创建多保单关联表 -->
    <changeSet id="3" author="titanium">
        <createTable tableName="t_policy_multi_relation">
            <column name="id" type="VARCHAR(32)" constraints="primaryKey notNull" comment="关联ID（雪花算法）"/>
            <column name="tenant_id" type="VARCHAR(32)" constraints="notNull" comment="租户ID"/>
            <column name="main_policy_id" type="VARCHAR(32)" constraints="notNull" comment="主保单ID"/>
            <column name="sub_policy_id" type="VARCHAR(32)" constraints="notNull" comment="子保单ID（复合险/家庭险）"/>
            <column name="relation_type" type="VARCHAR(32)" constraints="notNull" comment="关联类型（COMPOSITE/FAMILY）"/>
            <column name="create_time" type="DATETIME" constraints="notNull" defaultValueComputed="CURRENT_TIMESTAMP" comment="创建时间"/>
            <column name="update_time" type="DATETIME" constraints="notNull" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" comment="更新时间"/>
            <column name="created_by" type="VARCHAR(32)" constraints="notNull" comment="创建人"/>
            <column name="updated_by" type="VARCHAR(32)" constraints="notNull" comment="更新人"/>
            <column name="is_deleted" type="TINYINT" constraints="notNull" defaultValue="0" comment="是否删除（0: 未删除, 1: 已删除）"/>
        </createTable>
        
        <!-- 创建索引 -->
        <addUniqueConstraint tableName="t_policy_multi_relation" constraintName="uk_main_sub_relation" columnNames="main_policy_id, sub_policy_id, relation_type"/>
        <createIndex tableName="t_policy_multi_relation" indexName="idx_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="t_policy_multi_relation" indexName="idx_main_policy_id">
            <column name="main_policy_id"/>
        </createIndex>
        <createIndex tableName="t_policy_multi_relation" indexName="idx_sub_policy_id">
            <column name="sub_policy_id"/>
        </createIndex>
        <createIndex tableName="t_policy_multi_relation" indexName="idx_relation_type">
            <column name="relation_type"/>
        </createIndex>
    </changeSet>
    
    <!-- 创建保单文档表 -->
    <changeSet id="4" author="titanium">
        <createTable tableName="t_policy_document">
            <column name="id" type="VARCHAR(32)" constraints="primaryKey notNull" comment="文档ID（雪花算法）"/>
            <column name="tenant_id" type="VARCHAR(32)" constraints="notNull" comment="租户ID"/>
            <column name="policy_id" type="VARCHAR(32)" constraints="notNull" comment="保单ID"/>
            <column name="document_type" type="VARCHAR(32)" constraints="notNull" comment="文档类型（POLICY/ENDORSEMENT/CERTIFICATE）"/>
            <column name="document_name" type="VARCHAR(128)" constraints="notNull" comment="文档名称"/>
            <column name="document_content" type="TEXT" comment="文档内容"/>
            <column name="file_path" type="VARCHAR(256)" comment="文件路径"/>
            <column name="create_time" type="DATETIME" constraints="notNull" defaultValueComputed="CURRENT_TIMESTAMP" comment="创建时间"/>
            <column name="update_time" type="DATETIME" constraints="notNull" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" comment="更新时间"/>
            <column name="created_by" type="VARCHAR(32)" constraints="notNull" comment="创建人"/>
            <column name="updated_by" type="VARCHAR(32)" constraints="notNull" comment="更新人"/>
            <column name="is_deleted" type="TINYINT" constraints="notNull" defaultValue="0" comment="是否删除（0: 未删除, 1: 已删除）"/>
        </createTable>
        
        <!-- 创建索引 -->
        <createIndex tableName="t_policy_document" indexName="idx_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="t_policy_document" indexName="idx_policy_id">
            <column name="policy_id"/>
        </createIndex>
        <createIndex tableName="t_policy_document" indexName="idx_document_type">
            <column name="document_type"/>
        </createIndex>
    </changeSet>

    <!-- CQRS 读模型投影表（事件投影维护，读写分离） -->
    <include file="liquibase/20260623_policy_view_projection.xml"/>
    <!-- 父子保单关系读模型表（团单主子联动级联） -->
    <include file="liquibase/20260627_policy_relation_projection.xml"/>
    <!-- 批单读模型表 + 保单读模型当前版本号列（数据/要素类批改） -->
    <include file="liquibase/20260628_policy_endorsement_projection.xml"/>
    <!-- 投保单/意向单读模型表（补齐 Insurance/Proposal CQRS 读写分离） -->
    <include file="liquibase/20260701_insurance_proposal_view_projection.xml"/>
</databaseChangeLog>