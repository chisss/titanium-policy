<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- 投保单 CQRS 读模型表：由领域事件投影维护，与写侧 t_insurance 物理隔离 -->
    <changeSet id="20260701-insurance-view-projection" author="titanium-cqrs">
        <createTable tableName="t_insurance_view" remarks="投保单读模型表（CQRS Projection）">
            <column name="insurance_id" type="VARCHAR(36)" remarks="投保单ID（读模型主键）">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_t_insurance_view"/>
            </column>
            <column name="insurance_no" type="VARCHAR(64)" remarks="投保单编号（高频查询）">
                <constraints nullable="false"/>
            </column>
            <column name="proposal_id" type="VARCHAR(36)" remarks="关联意向单ID"/>
            <column name="policy_form" type="VARCHAR(32)" remarks="保单形态"/>
            <column name="holder_id" type="VARCHAR(36)" remarks="投保人ID"/>
            <column name="insured_count" type="INT" remarks="被保险人数"/>
            <column name="exact_premium" type="DECIMAL(18,2)" remarks="精确保费"/>
            <column name="currency" type="VARCHAR(8)" remarks="币种"/>
            <column name="insurance_period_start" type="DATETIME" remarks="保险起期"/>
            <column name="insurance_period_end" type="DATETIME" remarks="保险止期"/>
            <column name="status_code" type="VARCHAR(32)" remarks="投保单状态">
                <constraints nullable="false"/>
            </column>
            <column name="underwriting_result_code" type="VARCHAR(32)" remarks="核保结论"/>
            <column name="underwriting_id" type="VARCHAR(36)" remarks="核保单号"/>
            <column name="issued_time" type="DATETIME" remarks="承保时间"/>
            <column name="tenant_id" type="VARCHAR(36)" remarks="租户ID（多租户隔离）">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="DATETIME" remarks="读模型创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="DATETIME" remarks="读模型更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0" remarks="乐观锁版本">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="t_insurance_view" constraintName="uk_insurance_view_no_tenant"
                             columnNames="insurance_no, tenant_id"/>
        <createIndex tableName="t_insurance_view" indexName="idx_insurance_view_tenant_status">
            <column name="tenant_id"/>
            <column name="status_code"/>
        </createIndex>
        <createIndex tableName="t_insurance_view" indexName="idx_insurance_view_holder">
            <column name="tenant_id"/>
            <column name="holder_id"/>
        </createIndex>
        <createIndex tableName="t_insurance_view" indexName="idx_insurance_view_proposal">
            <column name="tenant_id"/>
            <column name="proposal_id"/>
        </createIndex>
    </changeSet>

    <!-- 投保意向单 CQRS 读模型表：由领域事件投影维护，与写侧 t_proposal 物理隔离 -->
    <changeSet id="20260701-proposal-view-projection" author="titanium-cqrs">
        <createTable tableName="t_proposal_view" remarks="投保意向单读模型表（CQRS Projection）">
            <column name="proposal_id" type="VARCHAR(36)" remarks="意向单ID（读模型主键）">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_t_proposal_view"/>
            </column>
            <column name="proposal_no" type="VARCHAR(64)" remarks="意向单编号（高频查询）">
                <constraints nullable="false"/>
            </column>
            <column name="policy_form" type="VARCHAR(32)" remarks="保单形态"/>
            <column name="channel" type="VARCHAR(32)" remarks="销售渠道"/>
            <column name="customer_id" type="VARCHAR(36)" remarks="客户ID"/>
            <column name="intended_sum_insured" type="DECIMAL(18,2)" remarks="意向保额"/>
            <column name="intended_premium" type="DECIMAL(18,2)" remarks="意向保费"/>
            <column name="insurance_period_start" type="DATETIME" remarks="保险起期"/>
            <column name="insurance_period_end" type="DATETIME" remarks="保险止期"/>
            <column name="expected_product_code" type="VARCHAR(64)" remarks="期望险种编码"/>
            <column name="status_code" type="VARCHAR(32)" remarks="意向单状态">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)" remarks="租户ID（多租户隔离）">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="DATETIME" remarks="读模型创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="DATETIME" remarks="读模型更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0" remarks="乐观锁版本">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="t_proposal_view" constraintName="uk_proposal_view_no_tenant"
                             columnNames="proposal_no, tenant_id"/>
        <createIndex tableName="t_proposal_view" indexName="idx_proposal_view_tenant_status">
            <column name="tenant_id"/>
            <column name="status_code"/>
        </createIndex>
        <createIndex tableName="t_proposal_view" indexName="idx_proposal_view_customer">
            <column name="tenant_id"/>
            <column name="customer_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
