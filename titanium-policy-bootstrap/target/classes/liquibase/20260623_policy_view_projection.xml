<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- CQRS 读模型表：由领域事件投影维护，与写侧 t_policy 物理隔离 -->
    <changeSet id="20260623-policy-view-projection" author="titanium-cqrs">
        <createTable tableName="t_policy_view" remarks="保单读模型表（CQRS Projection）">
            <column name="policy_id" type="VARCHAR(36)" remarks="保单ID（读模型主键）">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_t_policy_view"/>
            </column>
            <column name="policy_no" type="VARCHAR(64)" remarks="保单号（高频查询）">
                <constraints nullable="false"/>
            </column>
            <column name="insurance_id" type="VARCHAR(36)" remarks="关联投保单ID"/>
            <column name="policy_status" type="VARCHAR(32)" remarks="保单状态">
                <constraints nullable="false"/>
            </column>
            <column name="premium" type="DECIMAL(18,2)" remarks="保费"/>
            <column name="currency" type="VARCHAR(8)" remarks="币种"/>
            <column name="start_date" type="DATETIME" remarks="保险起期"/>
            <column name="end_date" type="DATETIME" remarks="保险止期"/>
            <column name="issue_time" type="DATETIME" remarks="签发时间"/>
            <column name="policy_holder_id" type="VARCHAR(36)" remarks="投保人ID"/>
            <column name="policy_holder_name" type="VARCHAR(128)" remarks="投保人姓名"/>
            <column name="insured_name" type="VARCHAR(128)" remarks="被保险人姓名"/>
            <column name="product_code" type="VARCHAR(64)" remarks="险种编码"/>
            <column name="tenant_id" type="VARCHAR(36)" remarks="租户ID（多租户隔离）">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="DATETIME" remarks="读模型创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="DATETIME" remarks="读模型更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0" remarks="乐观锁版本">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 高频查询索引：保单号+租户唯一 -->
        <addUniqueConstraint tableName="t_policy_view" constraintName="uk_policy_view_no_tenant"
                             columnNames="policy_no, tenant_id"/>
        <createIndex tableName="t_policy_view" indexName="idx_policy_view_tenant_status">
            <column name="tenant_id"/>
            <column name="policy_status"/>
        </createIndex>
        <createIndex tableName="t_policy_view" indexName="idx_policy_view_holder">
            <column name="tenant_id"/>
            <column name="policy_holder_id"/>
        </createIndex>
        <createIndex tableName="t_policy_view" indexName="idx_policy_view_date">
            <column name="start_date"/>
            <column name="end_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
