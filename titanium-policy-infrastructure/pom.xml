<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-policy</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-policy-infrastructure</artifactId>
    <name>titanium-policy-infrastructure</name>
    <description>保单系统 - 基础设施层</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 领域层 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-policy-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 应用层：基础设施的入站适配器(Kafka Listener 等 driving adapter)消费外部事件后，
             调用应用层用例/编排策略。方向 infra→application 符合洋葱(外层依赖内层)；application 不依赖 infra，无循环。 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-policy-application</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        
        <!-- Spring Boot Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- MySQL Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        
        <!-- Spring Kafka -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        
        <!-- Common Project -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-common</artifactId>
        </dependency>

        <!-- Fastjson（出单配置弱类型解析） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- OpenFeign（跨域调用 Adapter 直接注入各域 Feign Api） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- 产品系统API -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 客户主数据 API（出单参与方解析适配器） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-customer-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 条款系统API -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 规则引擎API -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-rule-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 核保系统API -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-underwriting-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 计费系统API（承保出单后经 BillingServicePort 开立首期保费账单） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-billing-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 投资系统API（投连/万能保单出单后经 InvestmentAccountPort 开立投资账户） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-investment-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 支付系统API（出单收费经 PaymentServicePort 创建支付单并发起收款） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-payment-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Liquibase -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <!-- mapstruct-->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 禁用Spring Boot Maven Plugin的repackage目标，因为这是一个领域层模块，不需要主类 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
