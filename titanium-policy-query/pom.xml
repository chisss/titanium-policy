<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>titanium-policy</artifactId>
        <groupId>com.titanium</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>titanium-policy-query</artifactId>
    <name>titanium-policy-query</name>
    <description>保单系统查询模块，用于处理复杂的保单查询</description>

    <dependencies>
        <!-- 核心依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!-- Spring缓存抽象核心依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Spring Data Redis核心依赖（包含RedisCacheManager） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>


        <!-- 项目内部依赖 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-policy-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-policy-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 通用内核（读模型基类 BaseView 等共享构件） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 查询层为依赖模块，禁用 Spring Boot repackage（无主类，不打可执行 jar） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!--
                编译器（含 MapStruct + Lombok 注解处理器）配置统一继承 titanium-parent：
                mapstruct-processor + lombok + lombok-mapstruct-binding 三者齐全，
                且 -Amapstruct.defaultComponentModel=spring。此前本模块曾本地覆盖该插件，
                但遗漏 lombok-mapstruct-binding，导致 MapStruct 看不到 View 子类的 Lombok
                访问器（仅能解析父类预编译访问器），新增读模型投影 Mapper 编译失败。
                移除本地覆盖、回归父 POM 权威配置（与 billing-query 一致）。
            -->
        </plugins>
    </build>
</project>