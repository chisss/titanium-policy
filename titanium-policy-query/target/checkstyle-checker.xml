<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Titanium 保险核心系统 - Checkstyle 规则集（共享 classpath 资源）
  打包进 titanium-build-tools jar，各域经 maven-checkstyle-plugin 的 plugin dependency
  以 classpath 方式引用（configLocation=titanium/checkstyle.xml），消除"每域复制规则集"的漂移源。
  将 CLAUDE.md 中「可被静态检查」的编码规约固化为构建期校验。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- 文件级：禁止 Tab 缩进（统一空格） -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="TreeWalker">

        <!-- ========== 导入规范：必须 import，禁止全限定名 ========== -->
        <!-- 禁止冗余 import -->
        <module name="RedundantImport"/>
        <!-- 禁止未使用 import -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <!-- 禁止 * 通配导入（强制显式 import） -->
        <module name="AvoidStarImport"/>

        <!-- ========== 日志规范：禁止 System.out / System.err ========== -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="禁止使用 System.out/System.err，请使用 SLF4J 日志"/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- ========== 日志规范：禁止字符串拼接式日志 ========== -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="log\.(info|debug|warn|error|trace)\s*\(\s*&quot;[^&quot;]*&quot;\s*\+"/>
            <property name="message" value="禁止日志字符串拼接，请使用 SLF4J {} 占位符"/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- ========== 命名规范 ========== -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>

        <!-- ========== 基本代码质量 ========== -->
        <!-- 禁止空代码块 -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE"/>
        </module>
        <!-- 必须使用大括号 -->
        <module name="NeedBraces"/>
        <!-- 禁止空语句 -->
        <module name="EmptyStatement"/>
        <!-- equals 与 hashCode 成对 -->
        <module name="EqualsHashCode"/>
        <!-- 禁止 == 比较字符串 -->
        <module name="StringLiteralEquality"/>

    </module>
</module>
